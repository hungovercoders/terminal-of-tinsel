# Played by docs/demos/render.sh, which draws it with the theme in theme.json.
# Written in the language of VHS, but not played by it: see render.sh.
Set FontSize 15
Set Width 1100
Set Height 700
Set Padding 24
Set TypingSpeed 60ms

Sleep 400ms
Type "terminal-of-tinsel creature"
Sleep 300ms
Enter
Sleep 7s
Type "x"
Sleep 2.5s
Type "x"
Sleep 3s
Tab
Sleep 2.5s
Tab
Sleep 1.5s
Type "r"
Sleep 3s
Type "1"
Sleep 400ms
Right
Sleep 700ms
Right
Sleep 700ms
Right
Sleep 700ms
Right
Sleep 700ms
Right
Sleep 700ms
Right
Sleep 3s
Type "/"
Sleep 300ms
Type "porridge"
Sleep 1.5s
Enter
Sleep 2.5s
Type "g"
Sleep 3s
Type "q"
Sleep 2.5s
