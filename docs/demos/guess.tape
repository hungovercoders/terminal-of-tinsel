# Played by docs/demos/render.sh, which draws it with the theme in theme.json.
# Written in the language of VHS, but not played by it: see render.sh.
Set FontSize 15
Set Width 1000
Set Height 560
Set Padding 24
Set TypingSpeed 60ms

# With seed 25 the guest is the Yule Cat, option 3.
Sleep 400ms
Type "terminal-of-tinsel guess -n 1"
Sleep 300ms
Enter
Sleep 2.5s
Space
Sleep 1.5s
Space
Sleep 1.5s
Space
Sleep 2.5s
Type "3"
Sleep 3.5s
Enter
Sleep 3s
Type "x"
Sleep 2s
