# Recorded by docs/demos/render.sh, which fills in the theme from theme.json.
# Do not run vhs on this file directly.
Output docs/demos/.frames/stocking/
Set Shell bash
Set FontSize 14
Set Width 1100
Set Height 1500
Set Padding 24
Set TypingSpeed 60ms
Set Theme @theme.json
Set Framerate 50

Type "terminal-of-tinsel stocking"
Enter
Sleep 2s
