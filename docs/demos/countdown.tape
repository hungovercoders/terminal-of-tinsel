# Recorded by docs/demos/render.sh, which fills in the theme from theme.json.
# Do not run vhs on this file directly.
Output docs/demos/.frames/countdown/
Set Shell bash
Set FontSize 14
Set Width 1000
Set Height 560
Set Padding 24
Set TypingSpeed 60ms
Set Theme @theme.json
Set Framerate 50

Type "terminal-of-tinsel countdown --date 2026-12-13"
Enter
Sleep 2s
