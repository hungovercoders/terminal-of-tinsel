# Normalise line endings: LF in the repository and in every checkout. The
# portraits and the generated man pages are compared byte for byte in tests.
* text=auto

*.rs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.tape text eol=lf
*.1 text eol=lf
completions/* text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

*.png binary
*.gif binary
*.jpg binary
*.ico binary
*.woff2 binary
