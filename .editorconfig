# EditorConfig keeps coding styles consistent across editors and IDEs.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Rust: rustfmt's defaults.
[*.rs]
indent_style = space
indent_size = 4

# Trailing spaces can be line breaks in Markdown.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{yaml,yml,json,toml,sh}]
indent_style = space
indent_size = 2

# Portraits: the tests refuse trailing spaces, so let the editor remove them.
[packs/**/*.txt]
indent_style = space
trim_trailing_whitespace = true

# Generated by 'UPDATE_SHELLDOCS=1 cargo test shell_docs': leave them as written.
[{man,completions}/**]
trim_trailing_whitespace = false
insert_final_newline = false

[{.gitattributes,.gitignore}]
indent_style = space
indent_size = 2
